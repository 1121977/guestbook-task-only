<configuration scan="true" scanPeriod="10 seconds">
    <jmxConfigurator />

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="APP_LOG" class="ch.qos.logback.core.FileAppender">
        <file>logs/application.log</file>
        <encoder>
            <pattern>%date %level [%file:%line] %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="SPRING_SECURITY_LOG" class="ch.qos.logback.core.FileAppender">
        <file>logs/security.log</file>
        <encoder>
            <pattern>%date %level [%file:%line] %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.springframework.security" level="trace" additivity="false">
        <appender-ref ref="SPRING_SECURITY_LOG" />
    </logger>

    <logger name="ru.scr.WebApplicationConfig" level="trace" additivity="false">
        <appender-ref ref="APP_LOG" />
    </logger>

    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>
